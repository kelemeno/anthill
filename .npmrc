# Hoisted (flat) node_modules so the toolchain behaves like npm's layout — keeps
# packages that rely on hoisting working without --legacy-peer-deps.
node-linker=hoisted
# pnpm's clean equivalent of npm's --legacy-peer-deps: auto-install peers and
# don't fail the install on peer-range mismatches in the web3/wallet tree.
auto-install-peers=true
strict-peer-dependencies=false
